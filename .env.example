# MongoDB Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mess_allocation?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Seed Accounts
ADMIN_EMAIL=admin@example
ADMIN_PASS=Admin@1234
MESS1_EMAIL=mess1@example
MESS1_PASS=Mess1@1234
MESS2_EMAIL=mess2@example
MESS2_PASS=Mess2@1234

# Server Port
PORT=5000

